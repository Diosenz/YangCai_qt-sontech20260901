# 仅生成离线程序的构建清单，不调用编译器或设备。
file(READ "${REPLAY_DIRECTORY}/replay-inputs.json" inputs)
string(JSON source_root GET "${inputs}" source_root)
set(record "{\"schema_version\":1,\"source_sha256\":{},\"binaries\":{}}")
foreach(key IN ITEMS runtime_dirs dependency_versions)
    string(JSON value GET "${inputs}" ${key})
    string(JSON record SET "${record}" ${key} "${value}")
endforeach()
string(JSON source_count LENGTH "${inputs}" source_files)
math(EXPR source_last "${source_count}-1")
foreach(index RANGE ${source_last})
    string(JSON relative GET "${inputs}" source_files ${index})
    file(SHA256 "${source_root}/${relative}" hash)
    string(JSON record SET "${record}" source_sha256 "${relative}" "\"${hash}\"")
endforeach()
string(JSON binary_count LENGTH "${inputs}" binaries)
math(EXPR binary_last "${binary_count}-1")
foreach(index RANGE ${binary_last})
    string(JSON name MEMBER "${inputs}" binaries ${index})
    string(JSON filename GET "${inputs}" binaries ${name})
    file(SHA256 "${REPLAY_DIRECTORY}/${filename}" hash)
    string(JSON record SET "${record}" binaries ${name}
        "{\"file\":\"${filename}\",\"sha256\":\"${hash}\"}")
endforeach()
find_package(Git QUIET)
if(GIT_FOUND)
    execute_process(COMMAND "${GIT_EXECUTABLE}" rev-parse HEAD WORKING_DIRECTORY "${source_root}"
        OUTPUT_VARIABLE revision OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE git_result)
    if(git_result EQUAL 0)
        string(JSON record SET "${record}" build_revision "\"${revision}\"")
    endif()
endif()
file(WRITE "${REPLAY_DIRECTORY}/replay-native.json" "${record}\n")
message(STATUS "Offline KCF native manifest: ${REPLAY_DIRECTORY}/replay-native.json")
