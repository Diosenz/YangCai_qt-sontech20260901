+/** @brief 局部截面方向可变；不编码工件轮廓或焊缝路径类型。 */
+cv::Mat makeLocalStripe(const cv::Point2d &center, double leftSlope,
+    double rightSlope, double gap)
+{
+    cv::Mat image(480, 640, CV_8UC1);
+    for (int y = 0; y < image.rows; ++y) {
+        for (int x = 0; x < image.cols; ++x) {
+            const double dx = x - center.x;
+            const double stripe = center.y + (dx < 0.0 ? leftSlope : rightSlope) * dx
+                + (dx < 0.0 ? -gap * 0.5 : gap * 0.5);
+            const double distance = y - stripe;
+            image.at<unsigned char>(y, x) = cv::saturate_cast<unsigned char>(14.0
+                + 215.0 * std::exp(-distance * distance / 3.38));
+        }
+    }
+    return image;
+}
+
+v::OnlineSeamRefinementResult independentlyRefine(const cv::Mat &image,
+    const cv::Point2d &center)
+{
+    v::OnlineSeamRefinementOptions options;
+    options.heightPolicy = v::OnlineSeamHeightPolicy::GapCenter;
+    return v::COnlineSeamRefiner::refine(image, center, options);
 }
 
