root = true

[*]
charset = utf-8-bom
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{h,hpp,cpp,cxx}]
indent_style = space
indent_size = 4

[CMakeLists.txt]
indent_style = space
indent_size = 4
charset = utf-8-bom

[*.cmake]
indent_style = space
indent_size = 4
charset = utf-8-bom

[*.md]
indent_style = space
indent_size = 2
charset = utf-8-bom
trim_trailing_whitespace = false
